{
  "name": "mmo-idle",
  "private": true,
  "version": "0.4",
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db logdb redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db logdb redis",
    "db:logs": "docker compose logs -f db logdb redis",
    "docker:up": "docker compose --profile full up --build",
    "docker:dev": "pnpm docker:rebuild",
    "docker:rebuild": "node scripts/docker-rebuild.mjs",
    "docker:dev:build": "pnpm docker:rebuild",
    "docker:down": "docker compose --profile full --profile dev down",
    "dev:client": "pnpm --filter @mmo-idle/client dev",
    "dev:admin": "pnpm --filter @mmo-idle/admin dev",
    "dev:server": "pnpm db:up && pnpm --filter @mmo-idle/server dev",
    "build": "pnpm --filter @mmo-idle/shared build && pnpm --filter @mmo-idle/client build && pnpm --filter @mmo-idle/admin build && pnpm --filter @mmo-idle/server build",
    "build:client": "pnpm --filter @mmo-idle/client build",
    "build:admin": "pnpm --filter @mmo-idle/admin build",
    "play": "cross-env VITE_ENABLE_OPS_MAP=true pnpm build:client && cross-env NODE_ENV=production DEV_TOOLS=true pnpm dev:server",
    "bench:server": "pnpm --filter @mmo-idle/server bench",
    "bench:balance": "pnpm --filter @mmo-idle/server bench:balance",
    "test:balance-instruments": "pnpm --filter @mmo-idle/server exec tsx --conditions=development test/balanceInstruments.test.ts",
    "bench:tui": "cargo run --release --manifest-path tools/balance-tui/Cargo.toml --",
    "bot:run": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/run.ts",
    "bot:batch": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/batch.ts",
    "bot:cleanup": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/cleanup.ts",
    "bot:reference": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/reference.ts",
    "dps:report": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/dps-report.ts",
    "dps:report:no-conduit": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/dps-report.ts --exclude-conduit",
    "dps:llm": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/dps-report.ts --llm-packet",
    "dps:class-mechanics": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/dps-report.ts --class-mechanics",
    "dps:t4-mechanics": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/dps-report.ts --t4-subclass-mechanics",
    "ehp:report": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/ehp-report.ts",
    "ehp:report:no-conduit": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/ehp-report.ts --exclude-conduit",
    "ehp:llm": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/ehp-report.ts --llm-packet",
    "mob:report": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/mob-report.ts",
    "mob:llm": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/mob-report.ts --llm-packet",
    "tier:table": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/tier-table.ts",
    "boss:exam": "pnpm --filter @mmo-idle/server exec tsx --conditions=development bench/bossExam.ts",
    "monster:ref": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/monster-ref.ts",
    "monster:ref:md": "pnpm -C server exec tsx --tsconfig ../tools/tsconfig.json --conditions=development ../tools/monster-ref.ts --md",
    "art:import": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/import.ts",
    "art:seed": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/seed.ts",
    "art:generate": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/generate.ts",
    "art:review": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/review.ts",
    "art:pack": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/pack.ts",
    "art:status": "pnpm --dir server exec tsx --conditions=development ../tools/pixellab/status.ts",
    "art:wire": "node tools/pixellab/wire-items.mjs",
    "art:glyphs": "pnpm --dir server exec tsx --conditions=development ../tools/glyphs/draw.ts",
    "ui:shot": "pnpm --dir server exec tsx --conditions=development ../tools/uishot/shot.ts",
    "test": "node scripts/run-tests.mjs",
    "test:spatial": "pnpm --filter @mmo-idle/server exec tsx ../shared/src/systems/spatialHitbox.test.ts && pnpm --filter @mmo-idle/server exec tsx ../shared/src/collision/collision.test.ts",
    "bake:hitboxes": "pnpm --filter @mmo-idle/server bake:hitboxes",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:cut": "node scripts/release.mjs cut",
    "typecheck": "pnpm -r exec tsc --noEmit && pnpm run typecheck:bench",
    "typecheck:bench": "pnpm --filter @mmo-idle/server exec tsc --noEmit -p tsconfig.bench.json",
    "size:check": "node scripts/size-check.mjs",
    "bot:t2-catalogue": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2Catalogue.ts",
    "bot:t2-templates": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2Templates.ts",
    "bot:t2-validate": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tierEntry/validate.test.ts",
    "bot:t2-routes": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2Routes.ts",
    "bot:t2-reachability": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2Reachability.ts",
    "bot:t2-report": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2Report.ts",
    "bot:t2-catalyst-demand": "pnpm --filter @mmo-idle/bot exec tsx --conditions=development src/tools/t2CatalystDemand.ts"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3"
  }
}
