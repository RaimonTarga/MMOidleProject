{
  "name": "mmo-idle",
  "private": true,
  "version": "0.4",
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db logdb redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db logdb redis",
    "db:logs": "docker compose logs -f db logdb redis",
    "docker:up": "docker compose --profile full up --build",
    "docker:dev": "pnpm docker:rebuild",
    "docker:rebuild": "node scripts/docker-rebuild.mjs",
    "docker:dev:build": "pnpm docker:rebuild",
    "docker:down": "docker compose --profile full --profile dev down",
    "dev:client": "pnpm --filter @mmo-idle/client dev",
    "dev:admin": "pnpm --filter @mmo-idle/admin dev",
    "dev:server": "pnpm db:up && pnpm --filter @mmo-idle/server dev",
    "build": "pnpm --filter @mmo-idle/shared build && pnpm --filter @mmo-idle/client build && pnpm --filter @mmo-idle/admin build && pnpm --filter @mmo-idle/server build",
    "build:client": "pnpm --filter @mmo-idle/client build",
    "build:admin": "pnpm --filter @mmo-idle/admin build",
    "play": "cross-env VITE_ENABLE_OPS_MAP=true pnpm build:client && cross-env NODE_ENV=production DEV_TOOLS=true pnpm dev:server",
    "bench:server": "pnpm --filter @mmo-idle/server bench",
    "bench:balance": "pnpm --filter @mmo-idle/server bench:balance",
    "bench:tui": "cargo run --release --manifest-path tools/balance-tui/Cargo.toml --",
    "dps:report": "pnpm --dir server exec tsx --conditions=development ../tools/dps-report.ts",
    "dps:report:no-conduit": "pnpm --dir server exec tsx --conditions=development ../tools/dps-report.ts --exclude-conduit",
    "dps:llm": "pnpm --dir server exec tsx --conditions=development ../tools/dps-report.ts --llm-packet",
    "dps:class-mechanics": "pnpm --dir server exec tsx --conditions=development ../tools/dps-report.ts --class-mechanics",
    "dps:t4-mechanics": "pnpm --dir server exec tsx --conditions=development ../tools/dps-report.ts --t4-subclass-mechanics",
    "ehp:report": "pnpm --dir server exec tsx --conditions=development ../tools/ehp-report.ts",
    "ehp:report:no-conduit": "pnpm --dir server exec tsx --conditions=development ../tools/ehp-report.ts --exclude-conduit",
    "ehp:llm": "pnpm --dir server exec tsx --conditions=development ../tools/ehp-report.ts --llm-packet",
    "mob:report": "pnpm --dir server exec tsx --conditions=development ../tools/mob-report.ts",
    "mob:llm": "pnpm --dir server exec tsx --conditions=development ../tools/mob-report.ts --llm-packet",
    "test:spatial": "pnpm --filter @mmo-idle/server exec tsx ../shared/src/systems/spatialHitbox.test.ts && pnpm --filter @mmo-idle/server exec tsx ../shared/src/collision/collision.test.ts",
    "bake:hitboxes": "pnpm --filter @mmo-idle/server bake:hitboxes",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:cut": "node scripts/release.mjs cut",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "size:check": "node scripts/size-check.mjs"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
