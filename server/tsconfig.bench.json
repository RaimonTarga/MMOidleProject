{
  // `tsconfig.json` includes only `src` (it drives the emitted build, which is
  // rooted there), so the benches were never typechecked by `pnpm typecheck` or
  // CI. This config covers them. `test/` is deliberately still excluded — those
  // files carry a large backlog of pre-existing strictness errors and run fine
  // under tsx; cleaning them up is its own job.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  // `scripts/` as a whole is NOT included: it carries 5 pre-existing strictness
  // errors (netcode-baseline, t4ValidationExitPreflight, ttkSurvey) that are their
  // own cleanup. `bossScreen.ts` is listed individually because it is new, it is
  // clean, and an unchecked experiment runner is how a rename bug reaches a frozen
  // packet unnoticed. The three `_t1Boss*` files are listed for the same reason: the
  // T1 boss pass tunes shipped numbers against them, and a silent path typo in a boss
  // override reads as "the candidate did nothing".
  "include": ["src", "bench", "scripts/bossScreen.ts",
    "scripts/_t1BossLab.ts", "scripts/_t1BossPlan.ts", "scripts/_t1BossMatrix.ts",
    "scripts/_t1Sweep.ts"]
}
