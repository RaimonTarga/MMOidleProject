{
  "name": "@mmo-idle/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "bake:hitboxes": "tsx --conditions=development src/hitbox/bakeCli.ts",
    "dev": "pnpm run bake:hitboxes && tsx watch --conditions=development src/index.ts",
    "dev:docker": "pnpm run bake:hitboxes && nodemon --config nodemon.docker.json",
    "build": "tsc && tsx --conditions=development src/hitbox/bakeArtifactCli.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "bench": "tsx --conditions=development bench/run.ts",
    "bench:balance": "tsx --conditions=development bench/balanceRun.ts"
  },
  "dependencies": {
    "@mmo-idle/shared": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "miniplex": "^2.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.11",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
