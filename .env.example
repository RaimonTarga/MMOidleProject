# Copy to .env and fill in. .env is gitignored; this example file is committed.

# PixelLab API key for the art generation pipeline (tools/pixellab, docs/pixellab-pipeline-plan.md)
PIXELLAB_API_KEY=

# Discord OAuth (server-side only; never expose the secret through Vite variables)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback
CLIENT_URL=http://localhost:3000

# Optional non-production socket identity for offline development.
AUTH_DEV_BYPASS=0
# Set both values together to make the Vite client use the explicit dev identity.
VITE_AUTH_DEV_ACCOUNT_ID=
