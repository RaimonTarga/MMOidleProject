# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Rust build output ─────────────────────────────────────────────────────────
target/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Art pipeline (tools/pixellab) ─────────────────────────────────────────────
# Generated candidates awaiting review; winners are committed under art/src.
art/candidates/

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# Note: pnpm-lock.yaml is intentionally NOT ignored.
# Lockfiles should be committed so installs are reproducible.

# Browser screenshots and layout audits from `pnpm ui:shot` (diagnostic output).
.uishot/

# Local agent/tool scratch output (generation logs, review renders, calibration files).
tmp/

# Landing cinematic capture scratch: raw Playwright recordings, scouting stills,
# and the cached anchor session token. The ENCODED clip and poster are committed
# under client/public/landing/ — only this working directory is throwaway.
.landing/
