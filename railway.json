{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:client && pnpm --filter @mmo-idle/server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @mmo-idle/server start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
